{
    "name": "csfront-refreshed",
    "private": true,
    "version": "1.0.0",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": "24.x"
    },
    "type": "module",
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && pnpm lint:styles",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "quality": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
        "format": "prettier --write .",
        "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
        "lint:styles": "node scripts/check-styles.mjs",
        "perf:audit": "node scripts/lighthouse.mjs"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.103.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "@visx/axis": "^4.0.0",
        "@visx/responsive": "^4.0.0",
        "@visx/scale": "^4.0.0",
        "@visx/shape": "^4.0.0",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.4.2",
        "jwt-decode": "^4.0.0",
        "localforage": "^1.10.0",
        "lucide-react": "^0.577.0",
        "motion": "^13.4.1",
        "next": "^16.3.8",
        "radix-ui": "^1.4.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.71.1",
        "react-i18next": "^17.0.15",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "^5.0.1"
    }
}
