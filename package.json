{
    "name": "csfront-refreshed",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0",
        "build": "next build",
        "start": "next start",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "oxlint --deny-warnings && pnpm lint:styles",
        "lint:fix": "oxlint --fix && pnpm lint:styles",
        "test": "vitest run",
        "quality": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
        "format": "oxfmt --write .",
        "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
        "lint:styles": "node scripts/check-styles.ts",
        "perf:audit": "node scripts/lighthouse.mjs",
        "seo:audit": "node scripts/seo-audit.mjs",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "@tanstack/react-query": "^5.104.5",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "@visx/axis": "^4.0.0",
        "@visx/responsive": "^4.0.0",
        "@visx/scale": "^4.0.0",
        "@visx/shape": "^4.0.0",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.5.5",
        "jwt-decode": "^4.0.0",
        "localforage": "^1.10.0",
        "lucide-react": "^1.61.0",
        "motion": "^14.6.0",
        "next": "^16.4.2",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.90.0",
        "react-i18next": "^17.1.2",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "jsdom": "^30.1.3",
        "oxc-parser": "^0.155.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2004",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24.15.0 <25"
    },
    "packageManager": "pnpm@12.15.0"
}
